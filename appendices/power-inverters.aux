\@writefile{lof}{\contentsline {figure}{\numberline {51}{\ignorespaces Cross section of the assembly layout. The stars show the positions of the power inverter devices, rods labeled \textit  {CR} are control rods, and \textit  {IT} is an instrumentation tube.}}{59}{figure.caption.65}\protected@file@percent }
\newlabel{fig:placeholder}{{51}{59}{Cross section of the assembly layout. The stars show the positions of the power inverter devices, rods labeled \textit {CR} are control rods, and \textit {IT} is an instrumentation tube}{figure.caption.65}{}}
\newlabel{fig:powerdist_baseline}{{52a}{60}{Baseline --- cosine-shaped power profile peaked at the axial midplane, with reduced flux at the rod extremities due to neutron leakage}{figure.caption.66}{}}
\newlabel{sub@fig:powerdist_baseline}{{a}{60}{Baseline --- cosine-shaped power profile peaked at the axial midplane, with reduced flux at the rod extremities due to neutron leakage}{figure.caption.66}{}}
\newlabel{fig:powerdist_becaps}{{52b}{60}{Beryllium End Reflectors --- minimal redistribution relative to the baseline; the cosine shape is largely preserved, indicating limited effectiveness of passive end-reflection}{figure.caption.66}{}}
\newlabel{sub@fig:powerdist_becaps}{{b}{60}{Beryllium End Reflectors --- minimal redistribution relative to the baseline; the cosine shape is largely preserved, indicating limited effectiveness of passive end-reflection}{figure.caption.66}{}}
\newlabel{fig:powerdist_freshrods}{{52c}{60}{Fresh Fuel Rods --- elevated and asymmetric power distribution driven by the graded enrichment of the interleaved fresh rods; power remains center-heavy with a shifted axial profile}{figure.caption.66}{}}
\newlabel{sub@fig:powerdist_freshrods}{{c}{60}{Fresh Fuel Rods --- elevated and asymmetric power distribution driven by the graded enrichment of the interleaved fresh rods; power remains center-heavy with a shifted axial profile}{figure.caption.66}{}}
\newlabel{fig:powerdist_powerinverter}{{52d}{60}{Power Inverter Device --- distinctly inverted power profile. The UO$_2$ end regions of the Power Inverter rods produce localized high-flux zones at the axial extremities, while the CeO$_2$ central region yields a dark (low-power) band in the core midplane}{figure.caption.66}{}}
\newlabel{sub@fig:powerdist_powerinverter}{{d}{60}{Power Inverter Device --- distinctly inverted power profile. The UO$_2$ end regions of the Power Inverter rods produce localized high-flux zones at the axial extremities, while the CeO$_2$ central region yields a dark (low-power) band in the core midplane}{figure.caption.66}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {52}{\ignorespaces Axial power distribution maps for each design variant, rendered as Serpent flux tallies over the assembly cross-section. Brighter color indicates higher local neutron flux and power density. Each image is normalized independently.}}{60}{figure.caption.66}\protected@file@percent }
\newlabel{fig:power_dist_all}{{52}{60}{Axial power distribution maps for each design variant, rendered as Serpent flux tallies over the assembly cross-section. Brighter color indicates higher local neutron flux and power density. Each image is normalized independently}{figure.caption.66}{}}
